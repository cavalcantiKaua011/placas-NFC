# =====================================================================
# Copie para .env.local (desenvolvimento) ou cadastre na Vercel.
# Nunca coloque valores reais neste arquivo.
# =====================================================================

# --- Modo demonstração -------------------------------------------------
# true  = usa dados fictícios em memória. NÃO conecta ao Supabase,
#         não precisa de login real e nada é gravado em banco.
# false = modo real (Supabase). Padrão.
DEMO_MODE=false

# --- Supabase (obrigatório quando DEMO_MODE=false) ---------------------
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA-CHAVE-ANON-PUBLICA
# A chave "service_role" NÃO é usada por este projeto. Não a cadastre.

# --- Domínio público (obrigatório em produção) -------------------------
# Vai dentro dos QR Codes: https://SEU-DOMINIO/r/CODIGO
# Sem barra no final. Em desenvolvimento pode ficar vazio (usa o host atual).
NEXT_PUBLIC_SITE_URL=https://SEU-DOMINIO

# --- Privacidade das leituras (recomendado) ----------------------------
# Texto aleatório e secreto (ex.: gere com `openssl rand -hex 32`).
# Usado para transformar o IP do visitante em um hash irreversível, só para
# não contar a mesma leitura várias vezes em sequência. O IP não é salvo.
# Se ficar vazio, o hash não é gerado e toda leitura é contada.
IP_HASH_SALT=
